{{ 'ts-styles.css' | asset_url | stylesheet_tag }}

<div class="ts-scope">
  <section class="section container">
    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="feature-grid">
      {%- for block in section.blocks -%}
        {%- assign role_class = '' -%}
        {%- if forloop.index == 1 -%}{%- assign role_class = 'feature-lead' -%}
        {%- elsif forloop.last -%}{%- assign role_class = 'feature-closer' -%}
        {%- endif -%}
        <div class="feature {{ role_class }}" {{ block.shopify_attributes }}>
          {%- if role_class == 'feature-lead' -%}
            <div class="feature-lead-head">
              <div class="feature-icon">{{ block.settings.icon }}</div>
              <h3>{{ block.settings.title }}</h3>
            </div>
            <p>{{ block.settings.text }}</p>
          {%- elsif role_class == 'feature-closer' -%}
            <div class="feature-icon">{{ block.settings.icon }}</div>
            <div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- else -%}
            <div class="feature-icon">{{ block.settings.icon }}</div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "TS Feature Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Tolerance Supply"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "html", "id": "icon", "label": "Icon SVG", "info": "Pasted inline SVG markup" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TS Feature Grid",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z\"/><path d=\"M12 12l8-4.5M12 12v9M12 12L4 7.5\"/></svg>",
            "title": "Real Recommendations, Not Guesswork",
            "text": "We help you match the right machine to your actual project — not just the highest-margin SKU."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"14\" rx=\"1\"/><path d=\"M3 9h18M8 4v14\"/></svg>",
            "title": "Built for Shops and Makers Alike",
            "text": "Whether you're prototyping in a garage or running a two-person machine shop, we carry equipment that scales with you."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 19V7a2 2 0 012-2h6l6 6v8a2 2 0 01-2 2H6a2 2 0 01-2-2z\"/><path d=\"M12 5v6h6\"/></svg>",
            "title": "Classroom & Lab Ready",
            "text": "Durable, safe, well-documented equipment that fits STEM labs and makerspaces — with straight answers when you're buying for students, not just yourself."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 8v4l3 2\"/></svg>",
            "title": "Straight Answers on Specs and Safety",
            "text": "Laser class ratings, spindle torque, measurement accuracy — we tell you what actually matters before you buy."
          }
        }
      ]
    }
  ]
}
{% endschema %}
