{{ 'ts-styles.css' | asset_url | stylesheet_tag }}

<div class="ts-scope">
  <section class="section section-tight container" id="categories">
    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="category-grid">
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        <a class="category-card{% if forloop.index == 1 %} category-card-lead{% endif %}" href="{{ collection.url | default: '#' }}" {{ block.shopify_attributes }}>
          {%- if collection.image != blank -%}
            <div class="photo-slot">
              {{ collection.image | image_url: width: 800 | image_tag: alt: collection.title, style: 'width:100%; height:100%; object-fit:cover;' }}
            </div>
          {%- else -%}
            <div class="photo-slot"><span class="photo-slot-label">Photo pending</span></div>
          {%- endif -%}
          <div class="category-card-label"><span>{{ block.settings.label | default: collection.title }}</span><span>&rarr;</span></div>
        </a>
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "TS Category Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label override",
          "info": "Leave blank to use the collection title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TS Category Grid",
      "blocks": [
        { "type": "category", "settings": { "collection": "3d-printing", "label": "3D Printing" } },
        { "type": "category", "settings": { "collection": "cnc-machines", "label": "CNC Machines" } },
        { "type": "category", "settings": { "collection": "laser-systems", "label": "Laser Systems" } },
        { "type": "category", "settings": { "collection": "test-measurement", "label": "Test & Measurement" } }
      ]
    }
  ]
}
{% endschema %}
